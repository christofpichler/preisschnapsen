# Example configuration for Preisschnapsen.
# install.sh installs it as /etc/schnapsen/schnapsen.env (mode 640, root:schnapsen).
# Every value can also be overridden by a real environment variable.
# Path of this file: environment variable SCHNAPSEN_CONFIG (default /etc/schnapsen/schnapsen.env)

# Listen address and port (behind a reverse proxy use 127.0.0.1)
SCHNAPSEN_HOST=0.0.0.0
SCHNAPSEN_PORT=8080

# SQLite database and automatic backups (one after every closed round)
SCHNAPSEN_DB=/var/lib/schnapsen/schnapsen.db
SCHNAPSEN_BACKUP_DIR=/var/lib/schnapsen/backups

# Accounts (set the hashes with: schnapsen-passwd admin / schnapsen-passwd user)
# Role "admin": dashboard and admin area. Role "user" (variables *_DASHBOARD_*): dashboard only.
# Both roles share one Basic Auth realm ("Preisschnapsen").
SCHNAPSEN_ADMIN_USER=admin
SCHNAPSEN_ADMIN_HASH=
SCHNAPSEN_DASHBOARD_USER=user
SCHNAPSEN_DASHBOARD_HASH=
